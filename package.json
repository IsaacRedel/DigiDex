{
  "name": "digidex",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Um guia digital para explorar o universo Digimon.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "test": "node --test",
    "images:optimize": "python scripts/optimize-images.py",
    "check:images": "python tests/transparent-art.py && python tests/optimized_art.py",
    "test:browser": "node scripts/check-browser.mjs",
    "check": "npm test && npm run check:images && npm run build"
  },
  "engines": {
    "node": ">=22"
  }
}
